  {
    "number": "08",
    "slug": "ashkelon-retrospective",
    "title": "Ashkelon Retrospective — Redesign of an Existing Exhibition",
    "link": null,
    "metaLines": [],
    "creditsBefore": [],
    "description": [
      "The original exhibition presents archaeological excavations conducted in Ashkelon over three decades, focusing on the artifacts left behind by the city's ancient inhabitants. Through the discovered materials, it tells the story of Ashkelon from antiquity to the present day.",
      "In our design, we placed the Material at the heart of the exhibition. Inspired by material culture research, the design explores how matter can serve as a storyteller — bearing traces of past lives, evolving over time, and revealing the identity of the place and its people through what remains."
    ],
    "creditsAfter": [
      {
        "label": "In collaboration with",
        "text": "Maya Netzer"
